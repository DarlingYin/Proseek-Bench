{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction_id", "reference_id", "score", "reason"],
        "properties": {
          "prediction_id": {"type": "string", "const": "p0001"},
          "reference_id": {"type": "string", "const": "r0001"},
          "score": {"type": "integer", "minimum": 1, "maximum": 4},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  }
}
