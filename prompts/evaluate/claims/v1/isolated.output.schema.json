{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["results"],
  "properties":{"results":{"type":"array","minItems":1,"maxItems":1,"items":{
    "type":"object","additionalProperties":false,
    "required":["prediction_id","reference_id","reference_resolution_type","completion_checks","completion_status","score","reason"],
    "properties":{
      "prediction_id":{"type":"string","const":"p0001"},
      "reference_id":{"type":"string","const":"r0001"},
      "reference_resolution_type":{"type":"string","enum":["information_action","resolved_output","visible_direct_action"]},
      "completion_checks":{"type":"array","minItems":1,"maxItems":16,"items":{
        "type":"object","additionalProperties":false,
        "required":["requirement","materiality","completion_role","prediction_status","evidence_status","evidence_source","reason"],
        "properties":{
          "requirement":{"type":"string","minLength":1,"maxLength":512},
          "materiality":{"type":"string","enum":["decisive","non_decisive"]},
          "completion_role":{"type":"string","enum":["target","prerequisite","action","boundary"]},
          "prediction_status":{"type":"string","enum":["resolved","deferred","missing","different"]},
          "evidence_status":{"type":"string","enum":["supported","unsupported","contradicted","not_required"]},
          "evidence_source":{"type":"string","minLength":1,"maxLength":128},
          "reason":{"type":"string","minLength":1,"maxLength":960}
        }}},
      "completion_status":{"type":"string","enum":["complete","incomplete","different","contradicted"]},
      "score":{"type":"integer","minimum":1,"maximum":4},
      "reason":{"type":"string","minLength":1,"maxLength":1280}
    }}}}
}
