{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whole-file claims verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prediction_id",
          "reference_id",
          "pass",
          "reason"
        ],
        "properties": {
          "prediction_id": {
            "type": "string",
            "pattern": "^p[0-9]{4,}$"
          },
          "reference_id": {
            "type": "string",
            "pattern": "^r[0-9]{4,}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 240
          },
          "pass": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "pass": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "const": ""
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
